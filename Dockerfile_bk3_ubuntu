FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# 1. Install base utilities, curl, and PPA management tools first
RUN apt-get update && apt-get install -y \
    curl \
    git \
    unzip \
    ca-certificates \
    software-properties-common \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# 2. Add Ondřej Surý PPA for PHP and immediately update cache
RUN add-apt-repository ppa:ondrej/php \
    && apt-get update

# 3. Install Apache2, PHP 8.3, and correct Apache module package
RUN apt-get install -y \
    apache2 \
    php8.3 \
    php8.3-cli \
    libapache2-mod-php8.3 \
    php8.3-mysql \
    php8.3-curl \
    php8.3-mbstring \
    php8.3-xml \
    php8.3-zip \
    && rm -rf /var/lib/apt/lists/*

# 4. Install Node.js v22 via NodeSource
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 5. Enable Apache modules required for modern web apps
RUN a2enmod rewrite
RUN a2ensite 000-default.conf

RUN composer global require laravel/installer

# Set working directory
WORKDIR /var/www/html

# Expose HTTP port
EXPOSE 80

# Start Apache in the foreground
CMD ["apache2ctl", "-D", "FOREGROUND"]